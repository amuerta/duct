/* block comment */
// single line comment

include "array"

// global variables
num = 10;
str = "Josh";
bl  = true;
flt = 10.5;

const N = 20;

// enum - just a list of numeric constants
enum {
    READ    1,
    WRITE   2,
    EXEC    4,
}

// you can have enum without a namespace
enum {
    ONE 1,
    TWO ,
}

// simple function
add(l,r) {
    return l + r
}

