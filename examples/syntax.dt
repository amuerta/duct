    // list is indexed like tuples in Rust
    print(list.2)

    if n > 10 {
        print("number n is is greater than 10: ", n)
    } else {
        print("less or equal to 10")
    }
    
    array = array_fill(10, 1)
    loop i = 0 to 10 {
        print("i",i,  " = ", array[i])
    }

    for i = 0; i < 10; i++ {
        
    }

    vector = { x = 10, y = 20 }
